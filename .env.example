# BlueP Configuration
# These seed the initial settings.json (~/.config/bluep/settings.json).
# After first run, settings persist in that file and override these defaults.
# The BLUEP_SUPERVISED flag is read ONLY from the environment and cannot
# be relaxed by the persisted settings file.

# ── Supervised mode ──────────────────────────────────────────────────
# When true, disables AI panel, AI settings tab, Python settings tab,
# and the AI completion toggle. Use in classroom/exam deployments.
BLUEP_SUPERVISED=false

# ── AI Agent ─────────────────────────────────────────────────────────
BLUEP_AI_ENABLED=false
BLUEP_AI_PROVIDER=openai
BLUEP_AI_MODEL=gpt-4o
BLUEP_AI_API_KEY=your-api-key-here
BLUEP_AI_BASE_URL=https://api.openai.com/v1
BLUEP_AI_MAX_TOKENS=4096
BLUEP_AI_TEMPERATURE=0.7

# ── Theme ────────────────────────────────────────────────────────────
BLUEP_THEME=dark

# ── Editor settings ──────────────────────────────────────────────────
BLUEP_EDITOR_TAB_WIDTH=4
BLUEP_EDITOR_INSERT_SPACES=true
BLUEP_EDITOR_FONT=Monospace
BLUEP_EDITOR_FONT_SIZE=12
BLUEP_EDITOR_LINE_NUMBERS=true
BLUEP_EDITOR_HIGHLIGHT_CURRENT_LINE=true
BLUEP_EDITOR_AUTO_INDENT=true
BLUEP_EDITOR_SMART_BACKSPACE=true
BLUEP_EDITOR_SYNTAX_HIGHLIGHTING=true
# Autocomplete and AI completion are placeholders for future features.
BLUEP_EDITOR_AUTOCOMPLETE=false
BLUEP_EDITOR_AI_COMPLETION=false

# ── Python settings ───────────────────────────────────────────────────
BLUEP_PYTHON_INTERPRETER=python3
BLUEP_PYTHON_STARTUP=
BLUEP_AUTO_COMPILE_ON_SAVE=true
BLUEP_CLEAR_BENCH_ON_RECOMPILE=true
